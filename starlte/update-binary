#!/sbin/sh
# The Galaxy S9's Scion installer, run by TWRP: Scion's boot image onto BOOT and the iOS system image onto the
# partition installer.prop names (SYSTEM unless the installer was made otherwise). TWRP passes the updater's API version,
# the pipe to its screen and this zip. Nothing is unpacked: TWRP often has no unzip, and the system image is 2.5 GB, so
# every member is stored (not compressed) and copied straight out of the zip from the offset installer.prop gives,
# then read back and checked by its SHA-256. installer.prop is the zip's first member, so its own place is fixed.
OUTFD=$2
ZIP=$3
PROP_OFF=50             # 30 bytes of local header + "scion/installer.prop" (20)
PROP_SIZE=4096

ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
progress() { echo "set_progress $1" > /proc/self/fd/$OUTFD; }
abort() { ui_print "ERROR: $1"; ui_print "Nothing more was written."; exit 1; }

# copy LENGTH bytes from OFFSET of the zip to DEVICE, then check them against SHA
member() {
	ui_print "  writing $1 ($(($3 / 1048576)) MB) to $4"
	tail -c +$(($2 + 1)) "$ZIP" | head -c $3 > "$4" || abort "writing $1 to $4 failed"
	sync
	ui_print "  checking $1 as written"
	got=$(head -c $3 "$4" | sha256sum | cut -d' ' -f1)
	[ "$got" = "$5" ] || abort "$1 on $4 reads back wrong (sha256 $got, want $5)"
}

# a partition by its name, wherever this recovery keeps the names
part() {
	for d in /dev/block/by-name /dev/block/platform/*/by-name /dev/block/bootdevice/by-name; do
		[ -e "$d/$1" ] && { readlink -f "$d/$1"; return 0; }
	done
	return 1
}

ui_print " "
ui_print "Scion for the Galaxy S9"
ui_print " "
tail -c +$((PROP_OFF + 1)) "$ZIP" | head -c $PROP_SIZE > /tmp/scion-installer.prop
. /tmp/scion-installer.prop || abort "this zip's installer.prop cannot be read"
[ "$SCION_INSTALLER" = 1 ] || abort "this zip's installer.prop is not one (made by mkinstaller.sh?)"
ui_print "  $SCION_BUILD"

device=$(getprop ro.product.device)
bootloader=$(getprop ro.boot.bootloader)
case "$device:$bootloader" in
starlte:*|*:G960F*) ui_print "  phone: $device, boot loader $bootloader" ;;
*) abort "this is for the Galaxy S9 SM-G960F (starlte), and this phone says \"$device\", \"$bootloader\"" ;;
esac

BOOT=$(part BOOT) || abort "no BOOT partition found"
SYS=$(part "$SYSTEM_PART") || abort "no $SYSTEM_PART partition found"
boot_room=$(blockdev --getsize64 "$BOOT")
sys_room=$(blockdev --getsize64 "$SYS")
[ "$BOOT_SIZE" -le "$boot_room" ] || abort "the boot image ($BOOT_SIZE bytes) does not fit BOOT ($boot_room)"
[ "$SYSTEM_SIZE" -le "$sys_room" ] || abort "the system image ($SYSTEM_SIZE bytes) does not fit $SYSTEM_PART ($sys_room)"
ui_print "  BOOT $BOOT, $SYSTEM_PART $SYS ($((sys_room / 1048576)) MB)"

for m in /system /system_root /mnt/system /vendor; do umount "$m" 2>/dev/null; done
progress 0.1
ui_print " "
ui_print "The iOS system image -> $SYSTEM_PART (a few minutes)"
member "the system image" "$SYSTEM_OFF" "$SYSTEM_SIZE" "$SYS" "$SYSTEM_SHA256"
progress 0.9
ui_print "Scion's boot image -> BOOT"
member "the boot image" "$BOOT_OFF" "$BOOT_SIZE" "$BOOT" "$BOOT_SHA256"
progress 1.0
ui_print " "
ui_print "Done. Reboot > System starts Scion."
ui_print "To leave it: hold five fingers on the screen for 1.5 s"
ui_print "(back to TWRP, with the log), or Vol Down + Power."
ui_print "Android back: restore your BOOT and $SYSTEM_PART backups."
exit 0
